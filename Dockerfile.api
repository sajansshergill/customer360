FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt pyproject.toml ./
COPY src ./src
COPY config ./config
COPY api ./api
ENV PYTHONPATH=/app/src:/app
RUN pip install --no-cache-dir -r requirements.txt && pip install -e .
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
